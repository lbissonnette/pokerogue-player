# Copy to .env (git-ignored) or export these in your shell.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Optional thinking level: xhigh, high, medium, low, minimal, none, or a token count.
# A bare level applies to every model; MODEL=LEVEL applies to one model. Comma-separated.
# OPENROUTER_REASONING=low,google/gemini-3.5-flash-lite=high
